# --- Telegram ---
# Get a token from @BotFather
BOT_TOKEN=

# --- Supabase (Postgres) ---
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service role key (server-side only — NEVER expose to clients)
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM: Google Gemini (Flash) ---
# https://aistudio.google.com/apikey  (free tier in dev)
GEMINI_API_KEY=
# Free tier is limited per model/day; the provider auto-falls back to others.
GEMINI_MODEL=gemini-2.0-flash

# --- STT: Groq Whisper ---
# https://console.groq.com/keys  (free tier in dev)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3

# --- TTS: Azure Neural (preferred — multiple pt-PT voices) ---
# Create a "Speech service" (tier F0) at https://portal.azure.com
# Keys and Endpoint -> KEY 1 + Region. Leave empty to fall back to Piper.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_TTS_VOICE=pt-PT-RaquelNeural

# --- TTS: Piper (local fallback) ---
# Install: python3 -m venv .venv && ./.venv/bin/pip install piper-tts
# Then download a pt-PT voice into ./voices/ (also needs ffmpeg on PATH).
PIPER_BIN=./.venv/bin/piper
PIPER_VOICE=./voices/pt_PT-tugao-medium.onnx

# --- Runtime ---
# 'stub' uses fake providers (no external API calls) — default for early dev.
# 'live' wires in the real Groq / Gemini / Piper implementations.
PROVIDER_MODE=stub
NODE_ENV=development
LOG_LEVEL=info
